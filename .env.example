# Copy to .env.local and adjust. Variables must be prefixed with EXPO_PUBLIC_ to reach the app.

# Base URL of the CueAI server (no trailing slash). When unset the app talks to the
# machine running Metro on port 8000, which works for Expo Go on the same Wi-Fi
# and for emulators; on web it falls back to http://localhost:8000.
# EXPO_PUBLIC_API_URL=http://localhost:8000
